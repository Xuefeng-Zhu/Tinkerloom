{
  "name": "@tinkerloom/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "appwrite": "^29.1.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-appwrite": "^3.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "preview:web": "serve dist --single --listen tcp://127.0.0.1:8426 --no-clipboard --no-port-switching --no-compression",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "prettier --write App.tsx app.json src eslint.config.js",
    "format:check": "prettier --check App.tsx app.json src eslint.config.js",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android"
  },
  "private": true
}
